<app>
  <meta>
    <config width="250" height="350" />
    <data exp="" res="" />
  </meta>
  <content>
    <display id="result" style="width: 100%; height: 40; margin: 10; bg: 255,255,255; border: 1; font: Consolas,18; padding: 5">0</display>
    <grid id="buttons" style="width: 100%; height: 100%; margin: 10; cols: 4; gap: 5">
      <button>7</button>
      <button>8</button>
      <button>9</button>
      <button>/</button>
      <button>4</button>
      <button>5</button>
      <button>6</button>
      <button>*</button>
      <button>1</button>
      <button>2</button>
      <button>3</button>
      <button>-</button>
      <button>C</button>
      <button>0</button>
      <button>=</button>
      <button>+</button>
    </grid>
  </content>
</app>
