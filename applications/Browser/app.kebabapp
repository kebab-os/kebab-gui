<app>
  <meta>
    <config width="600" height="400" />
    <data url="https://google.com" input="https://google.com" page_surf="null" scroll_y="0" loading="false" error="" />
  </meta>
  <content>
    <input id="url" placeholder="https://google.com" style="width: 100%; height: 28; margin: 10; border: 1; bg: 245,245,245; border_color: 200,200,200" />
    <button id="clear" style="position: absolute; right: 10; top: 10; width: 20; height: 20">×</button>
    <viewport id="web" style="width: 100%; height: 100%; margin: 5; overflow: scroll" />
  </content>
</app>